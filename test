<!DOCTYPE html>
<html>
<head>
  <title>Speech Test</title>
</head>
<body>
  <button onclick="speakTamil()">Speak Tamil</button>
  <script>
    function speakTamil() {
      const msg = new SpeechSynthesisUtterance("வணக்கம். நீங்கள் எப்படி இருக்கிறீர்கள்?");
      msg.lang = 'ta-IN';

      // Wait for voices to load
      function speak() {
        const voices = speechSynthesis.getVoices();
        const tamilVoice = voices.find(v => v.lang === 'ta-IN') || voices.find(v => v.lang.startsWith('en'));
        if (tamilVoice) msg.voice = tamilVoice;

        speechSynthesis.speak(msg);
      }

      if (speechSynthesis.getVoices().length === 0) {
        speechSynthesis.onvoiceschanged = speak;
      } else {
        speak();
      }
    }
  </script>
</body>
</html>
